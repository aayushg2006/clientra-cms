# Copy this file to application-local.yml (same folder) and fill in your values.
# application-local.yml is git-ignored, so your passwords never reach GitHub.

spring:
  datasource:
    username: root
    password: CHANGE_ME_MYSQL_PASSWORD
  mail:
    # Gmail address and a 16-character Gmail App Password (see README > Email setup)
    username: your.address@gmail.com
    password: CHANGE_ME_GMAIL_APP_PASSWORD

app:
  jwt:
    # Any random string of at least 64 characters
    secret: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG_0123456789
  mail:
    # Set to true once the Gmail username/password above are filled in
    enabled: false
    from: "Clientra CMS <your.address@gmail.com>"
